;;; Compile the service without ASDF or SBCL. Run from the repository root.
(require :cmp)
(ensure-directories-exist "build/")
(let* ((source (truename "common-lisp/service.lisp"))
       (object (merge-pathnames "service.o" (truename "build/")))
       (output (merge-pathnames "lispm-auth-service" (truename "build/")))
       (sodium-prefix (or (ext:getenv "SODIUM_PREFIX") "/usr"))
       (prefix (pathname (concatenate 'string sodium-prefix "/")))
       (library (or (probe-file (merge-pathnames "lib/libsodium.a" prefix))
                    (probe-file (merge-pathnames "lib/x86_64-linux-gnu/libsodium.a" prefix))
                    (probe-file (merge-pathnames "lib/aarch64-linux-gnu/libsodium.a" prefix))
                    (error "Static libsodium is required under ~a" prefix)))
       (include (merge-pathnames "include/" prefix)))
  (let ((c::*cc-flags* (format nil "~a -I~a" c::*cc-flags* include)))
    (multiple-value-bind (compiled warnings failure)
        (compile-file source :system-p t :output-file object)
      (declare (ignore warnings))
      (unless (and compiled (not failure))
        (error "Service compilation failed"))))
  (c:build-program output
                   :lisp-files (list object)
                   :ld-flags (list (namestring library))
                   :epilogue-code '(funcall (find-symbol "MAIN" "LISPM-AUTH-SERVICE"))))
(ext:quit 0)
