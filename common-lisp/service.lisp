;;; One request per process. Binary fields are hex; passwords are UTF-8 bytes.
;; Do not emit diagnostics that might contain input or backtraces.
(setf *error-output* (make-broadcast-stream)
      *trace-output* (make-broadcast-stream)
      sb-ext:*invoke-debugger-hook* (lambda (condition hook)
                                      (declare (ignore condition hook))
                                      (sb-ext:exit :code 1)))
(require :asdf)
(let ((*standard-output* (make-broadcast-stream))
      (*trace-output* (make-broadcast-stream)))
  (asdf:load-system :cffi))

(cffi:define-foreign-library libsodium
  (:darwin (:or "libsodium.dylib" "/opt/homebrew/lib/libsodium.dylib" "/usr/local/lib/libsodium.dylib"))
  (:unix (:or "libsodium.so" "libsodium.so.23"))
  (t (:default "libsodium")))
(cffi:use-foreign-library libsodium)
(cffi:defctype size-t #+64-bit :uint64 #-64-bit :uint32)
(cffi:defcfun ("sodium_init" sodium-init) :int)
(cffi:defcfun ("randombytes_buf" randombytes-buf) :void (buf :pointer) (size size-t))
(cffi:defcfun ("sodium_memzero" sodium-memzero) :void (buf :pointer) (size size-t))
(cffi:defcfun ("crypto_pwhash" pwhash) :int
  (out :pointer) (outlen :unsigned-long-long) (passwd :pointer)
  (passwdlen :unsigned-long-long) (salt :pointer) (opslimit :unsigned-long-long)
  (memlimit size-t) (alg :int))
(cffi:defcfun ("crypto_aead_xchacha20poly1305_ietf_encrypt" sodium-encrypt) :int
  (out :pointer) (outlen :pointer) (msg :pointer) (msglen :unsigned-long-long)
  (aad :pointer) (aadlen :unsigned-long-long) (nsec :pointer) (nonce :pointer) (key :pointer))
(cffi:defcfun ("crypto_aead_xchacha20poly1305_ietf_decrypt" sodium-decrypt) :int
  (out :pointer) (outlen :pointer) (nsec :pointer) (cipher :pointer)
  (cipherlen :unsigned-long-long) (aad :pointer) (aadlen :unsigned-long-long)
  (nonce :pointer) (key :pointer))

(unless (>= (sodium-init) 0) (error "libsodium initialization failed"))

;; All allocated foreign buffers are tracked and wiped even on authentication failure.
(define-condition invalid-request (error) ())
(define-condition authentication-failure (error) ())
(defvar *buffers* nil)
(defvar *arrays* nil)
(defvar *strings* nil)
(defun bytes (n)
  (let ((v (make-array n :element-type '(unsigned-byte 8) :initial-element 0)))
    (push v *arrays*) v))
(defun foreign-buffer (n)
  (let ((p (cffi:foreign-alloc :uint8 :count (max 1 n))))
    (push (cons p (max 1 n)) *buffers*) p))
(defun foreign-bytes (v)
  (let ((p (foreign-buffer (length v))))
    (loop for b across v for i from 0 do (setf (cffi:mem-aref p :uint8 i) b)) p))
(defun from-foreign (p n)
  (let ((v (bytes n)))
    (dotimes (i n v) (setf (aref v i) (cffi:mem-aref p :uint8 i)))))
(defun join-bytes (&rest vectors)
  (let ((v (bytes (reduce #'+ vectors :key #'length))) (i 0))
    (dolist (part vectors v) (replace v part :start1 i) (incf i (length part)))))
(defun section (v start &optional (end (length v)))
  (let ((out (bytes (- end start)))) (replace out v :start2 start :end2 end) out))
(defun random-bytes (n)
  (let ((p (foreign-buffer n))) (randombytes-buf p n) (from-foreign p n)))
(defun unhex (s)
  (unless (evenp (length s)) (error 'invalid-request))
  (let ((v (bytes (/ (length s) 2))))
    (dotimes (i (length v) v)
      (let ((a (digit-char-p (char s (* i 2)) 16))
            (b (digit-char-p (char s (1+ (* i 2))) 16)))
        (unless (and a b) (error 'invalid-request))
        (setf (aref v i) (+ (* a 16) b))))))
(defun hex (v)
  (let ((out (make-string (* 2 (length v)))) (digits "0123456789abcdef"))
    (dotimes (i (length v) out)
      (setf (char out (* 2 i)) (char digits (ash (aref v i) -4))
            (char out (1+ (* 2 i))) (char digits (logand (aref v i) 15))))))
(defun derive (password salt)
  (let ((p (foreign-buffer 32)))
    ;; crypto_pwhash_ALG_ARGON2ID13 = 2, v19, 64 MiB, 3 passes, one lane.
    (unless (zerop (pwhash p 32 (foreign-bytes password) (length password)
                           (foreign-bytes salt) 3 (* 64 1024 1024) 2))
      (error "password derivation failed"))
    (from-foreign p 32)))
(defun aead (encrypt key nonce aad input)
  (let* ((len (if encrypt (+ (length input) 16) (- (length input) 16)))
         (out (foreign-buffer len))
         (outlen (foreign-buffer 8))
         (keyp (foreign-bytes key)) (noncep (foreign-bytes nonce))
         (aadp (foreign-bytes aad)) (inp (foreign-bytes input))
         (result (if encrypt
                     (sodium-encrypt out outlen inp (length input) aadp (length aad)
                                     (cffi:null-pointer) noncep keyp)
                     (sodium-decrypt out outlen (cffi:null-pointer) inp (length input)
                                     aadp (length aad) noncep keyp))))
    (unless (zerop result)
      (if encrypt (error "encryption failed") (error 'authentication-failure)))
    (unless (= len (cffi:mem-ref outlen :unsigned-long-long))
      (error "unexpected output length"))
    (from-foreign out len)))
(defun check-key (key) (unless (= (length key) 32) (error 'invalid-request)))
(defun check-blob (blob header minlen &optional exact)
  (unless (and (if exact (= (length blob) minlen) (>= (length blob) minlen))
               (equalp (section blob 0 4) header))
    (error 'invalid-request)))
(defun split-fields (line)
  ;; Tabs preserve empty binary fields; spaces are never accepted.
  (loop with start = 0 for i from 0 to (length line)
        when (or (= i (length line)) (char= (char line i) #\Tab))
          collect (prog1 (let ((field (subseq line start i))) (push field *strings*) field)
                    (setf start (1+ i)))))
(defun process-request (line)
  (when (> (count #\Tab line) 3) (error 'invalid-request))
  (let* ((parts (split-fields line)) (op (first parts))
         (args (mapcar #'unhex (rest parts)))
         (law #(76 65 87 1)) (lai #(76 65 73 1)))
    (labels ((arity (n) (unless (= (length args) n) (error 'invalid-request))))
      (cond
        ((string= op "random") (arity 0) (random-bytes 32))
        ((string= op "wrap")
         (arity 2) (let* ((key (first args)) (password (second args))
                          (salt (random-bytes 16)) (nonce (random-bytes 24))
                          (prefix (join-bytes law salt nonce)))
                     (check-key key)
                     (join-bytes prefix (aead t (derive password salt) nonce prefix key))))
        ((string= op "unwrap")
         (arity 2) (let ((blob (first args)) (password (second args)))
                     (check-blob blob law 92 t)
                     (aead nil (derive password (section blob 4 20))
                           (section blob 20 44) (section blob 0 44) (section blob 44))))
        ((string= op "encrypt")
         (arity 3) (let* ((key (first args)) (id (second args)) (msg (third args))
                          (nonce (random-bytes 24)) (prefix (join-bytes lai nonce)))
                     (check-key key)
                     (join-bytes prefix (aead t key nonce (join-bytes prefix id) msg))))
        ((string= op "decrypt")
         (arity 3) (let ((key (first args)) (id (second args)) (blob (third args)))
                     (check-key key) (check-blob blob lai 44)
                     (aead nil key (section blob 4 28)
                           (join-bytes (section blob 0 28) id) (section blob 28))))
        (t (error 'invalid-request))))))

(defconstant +max-request-length+ (* 16 1024 1024))
(defun bounded-line ()
  (let ((buffer (make-string +max-request-length+)))
    (push buffer *strings*)
    (loop for i from 0
          for ch = (read-char *standard-input* nil nil)
          do (cond ((null ch) (error 'invalid-request))
                   ((char= ch #\Newline) (return (subseq buffer 0 i)))
                   ((or (= i +max-request-length+) (> (char-code ch) 127))
                    (error 'invalid-request))
                   (t (setf (char buffer i) ch))))))

(let ((*buffers* nil) (*arrays* nil) (*strings* nil) (line nil) (response nil))
  (unwind-protect
       (handler-case
           (progn
             (setf line (bounded-line))
             (setf response (hex (process-request line)))
             (format t "ok~c~a~%" #\Tab response)
             (finish-output))
         (invalid-request () (format t "error~cinvalid~%" #\Tab) (finish-output))
         (authentication-failure () (format t "error~cauth~%" #\Tab) (finish-output))
         (error () (format t "error~cinternal~%" #\Tab) (finish-output)))
    (dolist (entry *buffers*) (sodium-memzero (car entry) (cdr entry)) (cffi:foreign-free (car entry)))
    (dolist (array *arrays*) (fill array 0))
    (dolist (string *strings*) (fill string #\Null))
    (when line (fill line #\Null))
    (when response (fill response #\Null))))
